/-
# 二乗の展開

  (a + b)² = a² + 2ab + b²

ここからは Mathlib（Lean の数学ライブラリ）を使う。実数 ℝ や、式の計算を任せられるタクティクが入っている。
-/
module                      -- Lean の新しいモジュール方式でこのファイルを扱う、という宣言（Mathlib を読むときは付ける。無いと警告が出る）
import Mathlib              -- Mathlib の全部を読み込む（必要な分だけ読む書き方もあるが、ここでは簡単さを取る）

-- 定理: どんな実数 a, b でも (a + b)² = a² + 2ab + b²。
-- `(a b : ℝ)` は「a と b は実数」。`^ 2` は2乗。
theorem my_add_sq (a b : ℝ) : (a + b) ^ 2 = a ^ 2 + 2 * a * b + b ^ 2 := by
  ring                      -- `ring` は、足し算・掛け算・累乗だけでできた等式を、両辺を展開して整理し見比べて示す

-- 同じ定理は Mathlib にすでにあり、`add_sq` という名前が付いている。
-- 名前が分かっていれば、証明はそれを当てはめるだけ。
example (a b : ℝ) : (a + b) ^ 2 = a ^ 2 + 2 * a * b + b ^ 2 :=
  add_sq a b                -- Mathlib の定理 add_sq に a, b を入れる

-- `ring` は実数が無限にあっても困らない。数を1つずつ代入して確かめるのではなく、
-- 文字式のまま変形して示しているから。和と差の積も同じように示せる。
example (a b : ℝ) : (a + b) * (a - b) = a ^ 2 - b ^ 2 := by
  ring                      -- 左辺を展開すると a² - ab + ab - b² = a² - b²
