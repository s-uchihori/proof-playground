/-
# 1 から n までの和の公式（数学的帰納法）

  1 + 2 + ... + n = n (n + 1) / 2

高校で習う帰納法の証明を、そのまま Lean に書く。
割り算を避けるため、まず両辺を 2 倍した形  2 * (1 + ... + n) = n * (n + 1)  を示す。
-/

-- 1 から n までの和を、プログラムとして定義する。
def sumTo : Nat → Nat       -- 自然数を受け取って自然数を返す関数
  | 0 => 0                  -- 0 までの和は 0
  | n + 1 => sumTo n + (n + 1)  -- (n + 1) までの和は、「n までの和」に (n + 1) を足したもの

-- 定義が思ったとおりか、具体的な数で確かめておく。1 + 2 + ... + 10 = 55。
example : sumTo 10 = 55 := by
  rfl                       -- 実際に計算すると 55 になる

-- 定理: どんな自然数 n でも 2 * (1 + ... + n) = n * (n + 1)。
theorem two_mul_sumTo (n : Nat) : 2 * sumTo n = n * (n + 1) := by
  induction n with          -- n についての数学的帰納法。ゴールが下の2つに分かれる
  | zero =>                 -- 【n = 0 の場合】ゴール: 2 * sumTo 0 = 0 * (0 + 1)
    rfl                     -- 両辺とも計算すると 0
  | succ k ih =>            -- 【n = k + 1 の場合】ih が帰納法の仮定: 2 * sumTo k = k * (k + 1)
                            -- ゴール:  2 * sumTo (k + 1) = (k + 1) * (k + 1 + 1)
    rw [sumTo]              -- sumTo の定義で書き換え →  2 * (sumTo k + (k + 1)) = (k + 1) * (k + 1 + 1)
    rw [Nat.mul_add]        -- 分配法則 a * (b + c) = a * b + a * c で左辺を展開
                            --   →  2 * sumTo k + 2 * (k + 1) = (k + 1) * (k + 1 + 1)
    rw [ih]                 -- 帰納法の仮定で 2 * sumTo k を k * (k + 1) に置き換え
                            --   →  k * (k + 1) + 2 * (k + 1) = (k + 1) * (k + 1 + 1)
    rw [← Nat.add_mul]      -- 分配法則 (a + b) * c = a * c + b * c を右から左へ使って (k + 1) でくくる
                            --   →  (k + 2) * (k + 1) = (k + 1) * (k + 1 + 1)
    rw [Nat.mul_comm]       -- 掛け算の順番を入れ替え →  (k + 1) * (k + 2) = (k + 1) * (k + 1 + 1)
                            -- 両辺が同じ形になったので、rw が自動で証明を閉じる

-- 系: よく見る形  1 + ... + n = n * (n + 1) / 2。
-- （Nat の `/` は切り捨ての割り算。n * (n + 1) は必ず偶数なので、ここでは普通の割り算と同じ）
theorem sumTo_eq (n : Nat) : sumTo n = n * (n + 1) / 2 := by
  have h := two_mul_sumTo n -- 上で示した定理を h という名前で手元に置く。h : 2 * sumTo n = n * (n + 1)
  omega                     -- 「2 * x = y ならば x = y / 2」は一次式の話なので omega が片付ける
